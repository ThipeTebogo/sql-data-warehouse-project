_Total Revenue = SUM('gold fact_sales'[sales_amount])

_Total Orders = DISTINCTCOUNT('gold fact_sales'[order_number])

_Total Cost = SUMX(
    'gold fact_sales',
    'gold fact_sales'[quantity] * RELATED('gold dim_products'[product_cost]))

_Revenue YTD = TOTALYTD([_Total Revenue], 'Date Table'[Date])

_Revenue PY = 
CALCULATE(
    [_Total Revenue],
    SAMEPERIODLASTYEAR('Date Table'[Date]))

_Revenue Growth % = 
DIVIDE([_Total Revenue] - [_Revenue PY], [_Revenue PY])

_Quantity Sold = SUM('gold fact_sales'[quantity])

_Gross Profit = [_Total Revenue] - [_Total Cost]

_Gross Margin % = DIVIDE([_Gross Profit], [_Total Revenue])

_Average Order Value = DIVIDE([_Total Orders], [_Total Orders]) 

_Delivery Days = 
AVERAGEX(
    'gold fact_sales',
    DATEDIFF('gold fact_sales'[order_date], 'gold fact_sales'[ship_date], DAY)
)

